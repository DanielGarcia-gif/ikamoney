# Copia este archivo como .env (cp .env.example .env). El .env NO se sube al repo.
# Los valores de abajo sirven tal cual para desarrollo local.

# --- Base de datos (los lee docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=root_local_cambiar
MYSQL_DATABASE=ikamoney
MYSQL_USER=ikamoney
MYSQL_PASSWORD=ikamoney_local_cambiar
MYSQL_PORT=3306

# --- Backend (FastAPI) ---
# Debe coincidir con usuario, contraseña, puerto y base de arriba.
DATABASE_URL=mysql+pymysql://ikamoney:ikamoney_local_cambiar@localhost:3306/ikamoney
CORS_ORIGINS=http://localhost:5173

# --- Herramienta de IA (aún no se usa; déjala vacía hasta que se necesite) ---
AI_API_KEY=

# --- Frontend (Vite solo expone las variables que empiezan con VITE_) ---
VITE_API_URL=http://localhost:8000
